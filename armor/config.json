{
  "server": {
    "host": "0.0.0.0",
    "port": 3000
  },
  "waf": {
    "enableCrs": true,
    "crsRulesPath": "./crs4"
  },
  "proxy": {
    "targetHost": "127.0.0.1",
    "targetPort": 8080
  },
  "sam": {
    "database": "telegraf",
    "measurement": "armor"
  },
  "oidc": {
    "enable": true,
    "clientID": "armor-proxy",
    "providerUrl": "http://localhost:3003/realms/Armor",
    "redirectApplication": "http://localhost:3000"
  },
  "elasticsearch": {
    "enable": true,
    "url": ["http://localhost:9200"]
  }
}
